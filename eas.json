{
    "cli": {
      "version": ">= 15.0.9",
      "appVersionSource": "remote"
    },
    "build": {
      "development": {
        "developmentClient": true,
        "distribution": "internal"
      },
      "preview": {
        "android": {
          "buildType": "apk"
        },
        "distribution": "internal",
        "environment": "preview"
      },
      "production": {
        "android": {
          "buildType": "app-bundle"
        },
        "autoIncrement": true
      }
    },
    "submit": {
      "production": {}
    }
  }
  