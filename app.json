{
  "expo": {
    "name": "Hannusato",
    "slug": "react-hannusato",
    "version": "1.4.0",
    "orientation": "portrait",
    "owner": "ciccio1604",
    "icon": "./assets/images/logoMini.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logoMini.png",
        "backgroundColor": "#ffffff",
        "versionCode": 4 
      },
      "package": "com.hannusatoapp.demoreact"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logoMini.png",
          "imageWidth": 100,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "83495cc4-9371-45dd-a03a-b2200ffe5772"
      }
    }
  }
}
